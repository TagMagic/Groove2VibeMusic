    "favicon": "@PROJECT_PATH@/assets/images/logo-round-128x128.png",
    "imageResize": true,
    "mbrsiteDomain": "4u8cfee8op",
    "usedWebp": false,
    "robotsSwitcher": false,
    "sitemapSwitcher": false,
    "sitemapSwitcherAuto": false,
    "siteUrl": false,
    "cookiesAlert": false,
    "gdpr": false,
    "uniqCompNum": 115,
    "versionPublish": "6.1.12",
    "screenshot": "screenshot.png",
    "global_footer_custom": "<script>\ndocument.addEventListener(\"click\", function (e) {\n  const video = e.target.closest(\".g2v-video\");\n  if (!video) return;\n\n  if (video.paused) {\n    video.muted = false;     // make sure sound is enabled\n    video.volume = 1.0;\n    video.play();\n  } else {\n    video.pause();\n    video.currentTime = 0;\n  }\n});\n</script>\n",
    "global_after_body": "<script>\n(function () {\n  const PREVIEW_BASE = \"/g2v/audio/previews/\"; // adjust if needed\n  const player = new Audio();\n  player.preload = \"metadata\";\n  player.loop = false;\n\n  let currentBtn = null;\n\n  function stop() {\n    player.pause();\n    player.currentTime = 0;\n    currentBtn = null;\n  }\n\n  player.addEventListener(\"ended\", () => { currentBtn = null; });\n  player.addEventListener(\"error\", () => { stop(); });\n\n  function buildSrc(key) {\n    key = (key || \"\").trim();\n    if (!key) return null;\n\n    // If full path or URL provided, use it as-is\n    if (key.includes(\"/\") || key.startsWith(\"http\")) return key;\n\n    // If extension provided, append to base\n    if (/\\.(mp3|wav|m4a)$/i.test(key)) return PREVIEW_BASE + key;\n\n    // Otherwise treat as filename stem\n    return PREVIEW_BASE + key + \".mp3\";\n  }\n\n  function bind() {\n    document.querySelectorAll(\"[data-audio-preview]\").forEach((btn) => {\n      if (btn.dataset.bound === \"1\") return;\n      btn.dataset.bound = \"1\";\n\n      btn.addEventListener(\"click\", async (e) => {\n        e.preventDefault();\n\n        const src = buildSrc(btn.getAttribute(\"data-audio-preview\"));\n        if (!src) return;\n\n        // Same button toggles stop\n        if (!player.paused && currentBtn === btn) {\n          stop();\n          return;\n        }\n\n        // Stop any currently playing preview\n        if (!player.paused) stop();\n\n        try {\n          player.src = src;\n          currentBtn = btn;\n          await player.play(); // user click -> mobile safe\n        } catch {\n          stop();\n        }\n      });\n    });\n  }\n\n  bind();\n  new MutationObserver(bind).observe(document.body, { childList: true, subtree: true });\n})();\n</script>\n",
    "publishChangesOnly": true,
    "global_header_custom": "<link href=\"https://fonts.googleapis.com/css2?family=Merienda:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n<meta name=\"p:domain_verify\" content=\"a5c062cca340a3fcbadc571369f12fe5\"/>\n",
    "google-analytics": "",
    "publishEditFolder": false
  },
